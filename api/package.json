{
  "name": "firmo-api",
  "private": true,
  "type": "module",
  "description": "API et worker de Firmo : canaux, IA, rendu, portail, administration.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@hono/node-server": "^2.1.8",
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "@resvg/resvg-js": "^2.6.2",
    "ai": "^7.0.173",
    "hono": "^4.13.18",
    "jose": "^6.2.17",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
